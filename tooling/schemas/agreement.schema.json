{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "agreement_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "draft",
        "review",
        "candidate"
      ]
    },
    "maintenance": {
      "enum": [
        "active",
        "paused",
        "retired"
      ]
    },
    "recommended": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agreement_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "text_revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "agreement_id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "base": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agreement_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "text_revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "agreement_id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "format_version",
    "agreement_id",
    "name",
    "kind",
    "purpose",
    "target_version",
    "stage",
    "maintenance",
    "recommended",
    "review",
    "base"
  ]
}
