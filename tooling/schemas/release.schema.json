{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "agreement_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "imported-draft",
        "candidate",
        "released"
      ]
    },
    "publication": {
      "type": [
        "object",
        "null"
      ]
    },
    "files": {
      "type": "object",
      "required": [
        "text.txt"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "source": {
      "type": "object"
    }
  },
  "required": [
    "format_version",
    "agreement_id",
    "version",
    "sha256",
    "display_name",
    "kind",
    "status",
    "publication",
    "source",
    "files"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "type": "object",
            "required": [
              "date",
              "channel",
              "confirmed_by",
              "basis"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
