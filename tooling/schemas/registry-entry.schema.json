{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 2
    },
    "agreement_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "imported-draft",
        "candidate",
        "prepared",
        "released"
      ]
    },
    "publication": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "prepared",
                "published"
              ]
            },
            "method": {
              "enum": [
                "verified-local-directory",
                "github-release"
              ]
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "confirmed_by": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "candidate_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "date",
                "confirmed_by",
                "basis",
                "candidate_sha256"
              ],
              "additionalProperties": false
            },
            "builder": {
              "type": "object",
              "properties": {
                "format_version": {
                  "const": 1
                },
                "tool_version": {
                  "type": "string",
                  "minLength": 1
                },
                "implementation_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "format_version",
                "tool_version",
                "implementation_sha256"
              ],
              "additionalProperties": false
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "assets": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "receipt": {
              "type": "object",
              "properties": {
                "verified_at": {
                  "type": "string",
                  "minLength": 1
                },
                "release_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "tag_commit": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "assets": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "required": [
                "verified_at",
                "release_id",
                "url",
                "tag_commit",
                "assets"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "method",
            "channel",
            "decision",
            "builder",
            "manifest_sha256",
            "assets"
          ],
          "additionalProperties": false
        }
      ]
    },
    "files": {
      "type": "object",
      "required": [
        "text.txt"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "object",
          "required": [
            "text.txt"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "snapshot": {
          "type": "object"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadata_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "commit",
        "tag",
        "files"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object"
    },
    "withdrawal": {
      "type": "object",
      "required": [
        "date",
        "reason",
        "confirmed_by"
      ],
      "properties": {
        "date": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "format_version",
    "agreement_id",
    "version",
    "sha256",
    "display_name",
    "kind",
    "status",
    "publication",
    "source",
    "files"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "candidate",
              "prepared",
              "released"
            ]
          }
        }
      },
      "then": {
        "required": [
          "notes",
          "review"
        ],
        "properties": {
          "source": {
            "required": [
              "snapshot",
              "source_sha256",
              "metadata_sha256",
              "target_version"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "prepared",
              "released"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "type": "object",
            "required": [
              "state",
              "method",
              "channel",
              "decision",
              "builder",
              "manifest_sha256",
              "assets"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "publication": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "required": [
              "receipt"
            ],
            "properties": {
              "state": {
                "const": "published"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "prepared"
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "not": {
              "required": [
                "receipt"
              ]
            },
            "properties": {
              "state": {
                "const": "prepared"
              }
            }
          }
        }
      }
    }
  ]
}
