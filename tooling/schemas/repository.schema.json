{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "migration": {
      "enum": [
        null,
        "provenance/repository-migration.json"
      ]
    }
  },
  "required": [
    "format_version",
    "repository_id",
    "migration"
  ],
  "additionalProperties": false
}
