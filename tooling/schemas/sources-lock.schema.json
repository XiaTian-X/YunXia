{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned protocol sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "sources"],
  "properties": {
    "format_version": {"const": 1, "type": "integer"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "commit", "agreements"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "repository": {"type": "string", "pattern": "^(https://|ssh://|git@)[^\\s]+$"},
          "repository_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
          "agreements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
          }
        }
      }
    }
  }
}
