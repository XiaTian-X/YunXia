{
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "origin": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "cutoff_commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "repository",
        "cutoff_commit"
      ],
      "additionalProperties": false
    },
    "retained_history": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^refs/heads/history/"
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "ref",
        "commit"
      ],
      "additionalProperties": false
    },
    "registry_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agreement": {
            "type": "object",
            "properties": {
              "agreement_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "agreement_id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "commit",
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "agreement",
          "files"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "origin",
    "retained_history",
    "registry_files",
    "payloads"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
